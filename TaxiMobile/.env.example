# Copy this file to .env and fill in your values.

# ── API ───────────────────────────────────────────────────────────────────────
# Android emulator → use 10.0.2.2; real device → use your LAN IP (e.g. 192.168.x.x)
API_BASE_URL=http://10.0.2.2:3000

# ── Google Maps ───────────────────────────────────────────────────────────────
GOOGLE_MAPS_API_KEY=
GOOGLE_MAPS_API_KEY_IOS=

# ── Stripe ────────────────────────────────────────────────────────────────────
STRIPE_PUBLISHABLE_KEY=

# ── Firebase ──────────────────────────────────────────────────────────────────
# Also place google-services.json in android/app/ and GoogleService-Info.plist in ios/
FIREBASE_PROJECT_ID=
