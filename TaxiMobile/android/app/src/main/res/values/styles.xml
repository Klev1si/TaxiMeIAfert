<resources>

    <!-- Base application theme -->
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:editTextBackground">@drawable/rn_edit_text_material</item>
    </style>

    <!--
      Android 12+ native splash screen (androidx.core:core-splashscreen).
      Shown instantly by the OS before any React Native code runs — eliminates
      the white flash on cold start.
      Parent must be Theme.SplashScreen for the API to function correctly.
    -->
    <style name="SplashTheme" parent="Theme.SplashScreen">
        <!-- Brand yellow background -->
        <item name="windowSplashScreenBackground">#F59E0B</item>
        <!-- Animated icon shown in the centre of the splash (API 31+) -->
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <!-- After the splash exits, switch to the real app theme -->
        <item name="postSplashScreenTheme">@style/AppTheme</item>
    </style>

</resources>
