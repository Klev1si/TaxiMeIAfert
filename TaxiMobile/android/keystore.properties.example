# Copy this file to keystore.properties and fill in your values.
# keystore.properties is in .gitignore — NEVER commit it.
#
# How to generate the keystore (run once):
#   keytool -genkey -v -keystore android/app/taxiapp-release.keystore \
#           -alias taxiapp -keyalg RSA -keysize 2048 -validity 10000
#
# Keep the .keystore file backed up safely — you cannot re-upload to the
# Play Store with a different key once your app is published.

storeFile=taxiapp-release.keystore
storePassword=CHANGE_ME
keyAlias=taxiapp
keyPassword=CHANGE_ME
