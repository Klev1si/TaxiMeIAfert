 - (void)beginLocationUpdatesWithDesiredAccuracy:(CLLocationAccuracy)desiredAccuracy distanceFilter:(CLLocationDistance)distanceFilter useSignificantChanges:(BOOL)useSignificantChanges
 {
+  // TaxiMeIAfert patch: create the manager BEFORE enabling background updates.
+  // Upstream called enableBackgroundLocationUpdates while _locationManager could
+  // still be nil, so allowsBackgroundLocationUpdates was silently never set.
+  if (!_locationManager) {
+    _locationManager = [CLLocationManager new];
+    _locationManager.delegate = self;
+  }
+#if !TARGET_OS_VISION
+  // A taxi stopped at a light or waiting for a passenger must keep reporting.
+  // With the iOS default (YES) Core Location pauses updates when it thinks the
+  // device is stationary and never resumes them while the app is backgrounded,
+  // leaving gaps in the ride's route.
+  _locationManager.pausesLocationUpdatesAutomatically = NO;
+  _locationManager.activityType = CLActivityTypeAutomotiveNavigation;
+#endif
+
   if (!_locationConfiguration.skipPermissionRequests) {
     [self requestAuthorization:nil error:nil];
   } else if (_locationConfiguration.enableBackgroundLocationUpdates) {
     [self enableBackgroundLocationUpdates];
   }
 
