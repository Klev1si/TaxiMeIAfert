# Copy this file to .env and fill in your values.
# All variables marked CHANGE_ME are required in production.

# ── App ───────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000

# ── PostgreSQL ────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=taxiapp
DB_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DB_NAME=taxiapp_db
DB_LOGGING=false

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ── JWT ───────────────────────────────────────────────────────────────────────
# Must be at least 32 characters — generate with: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_MIN_32_CHARS_RANDOM_SECRET
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=CHANGE_ME_DIFFERENT_MIN_32_CHARS_SECRET
JWT_REFRESH_EXPIRES_IN=30d

# ── Twilio (SMS / phone verification) ────────────────────────────────────────
TWILIO_MOCK=false
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=+1234567890

# ── Stripe ────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxx

# ── Firebase Admin (push notifications) ──────────────────────────────────────
FIREBASE_MOCK=false
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com
# Paste the full private key including header/footer lines:
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY\n-----END PRIVATE KEY-----\n"

# ── Google Maps (server-side geocoding / distance) ───────────────────────────
GOOGLE_MAPS_API_KEY=AIzaSyAYBI5oVv2TnqtysGBsIbWx4kvupAEiGEE

# ── Email (Brevo) ─────────────────────────────────────────────────────────────
# We send transactional email (password-reset codes, ride receipts,
# subscription reminders) through Brevo.
#
# Set SMTP_MOCK=false to actually send. When BREVO_API_KEY is set it takes
# precedence over the SMTP_* vars below and delivers over Brevo's HTTPS API
# (api.brevo.com, port 443) — this avoids the SMTP port-blocking that many
# cloud hosts (Railway etc.) impose. Get the key from Brevo → SMTP & API →
# API Keys.
SMTP_MOCK=false
BREVO_API_KEY=xkeysib-YOUR_BREVO_API_KEY

# Display name shown in subjects/headers/footers and used to build the
# default From address.
APP_NAME=TaxiMeIAfert

# The "From" address. The domain MUST be authenticated in Brevo (SPF + DKIM
# verified) or mail will be rejected / spam-binned. Use a no-reply mailbox
# on your own domain.
SMTP_FROM=TaxiMeIAfert <no-reply@taximeiafert.com>

# Address shown to users for support enquiries (email footers / "contact us").
SUPPORT_EMAIL=support@taximeiafert.com

# ── SMTP fallback (only used when BREVO_API_KEY is empty) ─────────────────────
# For Brevo SMTP: host=smtp-relay.brevo.com, port=587, user=<your Brevo login>,
# pass=<an SMTP key from Brevo → SMTP & API → SMTP>.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your_brevo_login@example.com
SMTP_PASS=YOUR_BREVO_SMTP_KEY

# ── CORS — comma-separated list of allowed front-end origins ─────────────────
# Example: https://dashboard.yourdomain.com,https://app.yourdomain.com
CORS_ORIGIN=https://dashboard.yourdomain.com

# ── App Versioning ────────────────────────────────────────────────────────────
APP_VERSION_IOS=1.0.0
APP_MIN_VERSION_IOS=1.0.0
APP_STORE_URL_IOS=https://apps.apple.com/app/taxiapp/id000000000

APP_VERSION_ANDROID=1.0.0
APP_MIN_VERSION_ANDROID=1.0.0
APP_STORE_URL_ANDROID=https://play.google.com/store/apps/details?id=com.taxiapp

# ── Business Rules ────────────────────────────────────────────────────────────
NOSHOW_DRIVER_WAIT_MINUTES=10
NOSHOW_PASSENGER_FEE=5.00
CANCEL_GRACE_MINUTES=2
CANCEL_FEE_ACCEPTED=2.00
CANCEL_FEE_EN_ROUTE=3.00
CANCEL_FEE_ARRIVED=5.00

# ── Dispatch Weights (must sum to 1.0) ────────────────────────────────────────
DISPATCH_W_DISTANCE=0.50
DISPATCH_W_RATING=0.25
DISPATCH_W_ACCEPTANCE=0.15
DISPATCH_W_EXPERIENCE=0.10
DISPATCH_NEW_DRIVER_ACCEPT_SCORE=0.70

# ── Driver Wallet ─────────────────────────────────────────────────────────────
DRIVER_COMMISSION_PCT=80

# ── Sign in with Apple ────────────────────────────────────────────────────────
# Set this to your iOS bundle id once the App ID exists in Apple Developer.
# The backend verifies that incoming Apple identity tokens were issued for
# this audience. APPLE_SERVICE_ID is only needed if you also use Sign in with
# Apple on the web — leave blank for now.
APPLE_BUNDLE_ID=com.taximelafert
APPLE_SERVICE_ID=
